<% const _pinTagId2 = (typeof pinterestTagId !== 'undefined' && pinterestTagId) ? pinterestTagId : (process.env.PINTEREST_TAG_ID || ''); %>
<% if (_pinTagId2) { %>
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof pintrk !== 'function') return;
    document.querySelectorAll('[data-track]').forEach(function (el) {
        el.addEventListener('click', function () {
            pintrk('track', 'Lead', { lead_type: this.getAttribute('data-track') });
        });
    });
});
</script>
<% } %>
