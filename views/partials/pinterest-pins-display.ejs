<!-- Pinterest Pins Display (server-side token, no client exposure) -->
<section class="py-20 bg-white border-t border-gray-100" aria-labelledby="pinterest-heading">
    <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <h2 id="pinterest-heading" class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">Formation Insights on Pinterest</h2>
            <p class="text-lg text-gray-600">Practical UK company formation guides, checklists, and cost breakdowns.</p>
        </div>
        <div id="pinterest-pins-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <!-- Pins load here -->
        </div>
        <div class="text-center mt-10">
            <a href="https://www.pinterest.com/ukltdregistration/" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-6 py-3 bg-[#e60023] text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-[#c8001e] transition-colors">
                Follow us on Pinterest
            </a>
        </div>
    </div>
</section>

<script>
(function () {
    var grid = document.getElementById('pinterest-pins-grid');
    if (!grid) return;

    // Lazy-load: only fetch when the section nears the viewport (protects LCP/CLS)
    function load() {
        fetch('/api/pinterest/pins', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
            .then(function (data) {
                var pins = (data && data.pins) || [];
                if (!pins.length) { grid.closest('section').remove(); return; }
                grid.innerHTML = pins.map(function (p) {
                    return '<a href="' + p.link + '" target="_blank" rel="noopener noreferrer" class="group block">' +
                        '<div class="relative overflow-hidden rounded-2xl bg-gray-100" style="aspect-ratio:2/3">' +
                        '<img src="' + p.image + '" alt="' + p.alt + '" width="400" height="600" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">' +
                        '</div>' +
                        '<p class="mt-3 text-xs font-bold text-gray-700 leading-snug line-clamp-2 group-hover:text-blue-600 transition-colors">' + p.title + '</p>' +
                        '</a>';
                }).join('');
            })
            .catch(function () { grid.closest('section').remove(); });
    }

    if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting) { io.disconnect(); load(); }
        }, { rootMargin: '300px' });
        io.observe(grid);
    } else {
        load();
    }
})();
</script>
<!-- End Pinterest Pins Display -->
