<%- include('../partials/header') %>
<%- include('../partials/navigation') %>

<main class="overflow-x-hidden">
    <!-- Hero Section -->
    <section class="bg-white pt-24 pb-32 overflow-hidden relative">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-brand-blue/5 rounded-full blur-3xl -z-10"></div>
        
        <div class="container mx-auto px-4 text-center">
            <div class="inline-flex items-center space-x-2 px-4 py-2 border border-green-100 bg-green-50/50 rounded-full mb-8">
