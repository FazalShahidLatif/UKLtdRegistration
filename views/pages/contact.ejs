    "postalCode": "WC2H 9JQ",
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 51.5148,
    "longitude": -0.1235
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
