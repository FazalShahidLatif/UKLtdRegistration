
<%- include('../partials/header') %>
<%- include('../partials/navigation') %>

<main class="bg-gray-50 min-h-screen flex items-center justify-center py-24">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto bg-white rounded-[3rem] shadow-2xl border border-gray-100 overflow-hidden flex flex-col md:flex-row">
            <!-- Left Side: Value Prop -->
            <div class="md:w-1/2 bg-brand-blue p-12 text-white flex flex-col justify-center relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
                <div class="relative z-10">
                    <div class="w-16 h-16 bg-white text-brand-blue rounded-2xl flex items-center justify-center mb-8 text-3xl shadow-xl">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    </div>
                    <h1 class="text-4xl font-black mb-6 tracking-tight leading-tight">The 2026 UK Founder's Checklist</h1>
                    <p class="text-blue-100 text-lg mb-8 font-medium leading-relaxed">
                        Stop guessing and start growing. We've distilled the entire UK incorporation process into 15 essential checkpoints.
                    </p>
                    <ul class="space-y-4 mb-8">
                        <li class="flex items-center space-x-3 text-sm font-bold text-blue-100">
                            <span class="w-5 h-5 bg-blue-400 rounded-full flex items-center justify-center text-[10px] text-white">✓</span>
                            <span>Companies House Filing Checklist</span>
                        </li>
                        <li class="flex items-center space-x-3 text-sm font-bold text-blue-100">
                            <span class="w-5 h-5 bg-blue-400 rounded-full flex items-center justify-center text-[10px] text-white">✓</span>
                            <span>ACSP Identity Verification Guide</span>
                        </li>
                        <li class="flex items-center space-x-3 text-sm font-bold text-blue-100">
                            <span class="w-5 h-5 bg-blue-400 rounded-full flex items-center justify-center text-[10px] text-white">✓</span>
                            <span>Business Banking Selection Matrix</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Side: Form -->
            <div class="md:w-1/2 p-12 flex flex-col justify-center">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-black text-gray-900 mb-3 tracking-tight">Grab Your Copy</h2>
                    <p class="text-gray-500 font-medium">Enter your email and we'll send the PDF guide instantly.</p>
                </div>
                
                <form id="checklist-form" class="space-y-6">
                    <div class="relative">
                        <input type="email" id="email" name="email" required placeholder="your@email.com"
                            class="w-full px-6 py-5 bg-gray-50 border-2 border-transparent focus:border-brand-blue focus:bg-white rounded-2xl transition-all duration-300 outline-none text-lg font-medium shadow-inner">
                    </div>
                    <button type="submit" class="w-full bg-brand-blue text-white py-5 rounded-2xl font-black text-sm uppercase tracking-widest hover:bg-brand-navy transition-all duration-300 shadow-xl shadow-blue-100 active:scale-95">
                        Send Me The Checklist
                    </button>
                </form>
                
                <div id="form-success" class="hidden text-center py-10">
                    <div class="w-16 h-16 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mx-auto mb-6 text-3xl">✓</div>
                    <h3 class="text-2xl font-black text-gray-900 mb-3">Check Your Inbox!</h3>
                    <p class="text-gray-600">The 2026 Checklist is on its way to you.</p>
                </div>
                
                <p class="text-center text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-8">
                    Zero Spam • Instant Delivery • 100% Privacy
                </p>
            </div>
        </div>
    </div>
</main>

<script>
(function() {
    const form = document.getElementById('checklist-form');
    if (!form) return;
    
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value;
        
        try {
            const resp = await fetch('/api/lead-capture', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, source: 'checklist-download' })
            });
            if (resp.ok) {
                form.classList.add('hidden');
                document.getElementById('form-success').classList.remove('hidden');
            } else {
                alert('Something went wrong. Please try again.');
            }
        } catch (err) {
            alert('Connection error. Please try again.');
        }
    });
})();
</script>

<%- include('../partials/footer') %>
