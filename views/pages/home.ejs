<%- include('../partials/header') %>
<%- include('../partials/navigation') %>

<main class="overflow-x-hidden">
    <!-- Hero Section -->
    <section class="bg-white pt-24 pb-32 overflow-hidden relative">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-brand-blue/5 rounded-full blur-3xl -z-10"></div>
        
        <div class="container mx-auto px-4 text-center">
            <div class="inline-flex items-center space-x-2 px-4 py-2 border border-blue-100 bg-blue-50/50 rounded-full mb-8">
                <div class="w-2 h-2 bg-brand-blue rounded-full animate-pulse"></div>
                <span class="text-[10px] font-black uppercase tracking-widest text-brand-blue">2026 Statutory Compliant</span>
            </div>
            
            <h1 class="text-5xl md:text-8xl font-black text-gray-900 mb-8 tracking-tighter leading-tight">
                Set Up Your UK Limited <br/> <span class="text-brand-blue">Company in Minutes.</span>
            </h1>
            
            <div class="max-w-3xl mx-auto mb-12">
                <p class="text-xl md:text-2xl text-gray-700 font-medium leading-relaxed mb-6">
                    100% online. Companies House approved. Same-day formation from £119.99. Trusted by 10,000+ founders worldwide.
                </p>
                <div class="flex items-center justify-center space-x-4">
                    <div class="flex items-center space-x-1 text-yellow-400">
                        <% for(let i=0; i<5; i++) { %>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <% } %>
                    </div>
                    <span class="text-sm font-bold text-gray-900">4.9/5 Excellent on Trustpilot</span>
                </div>
            </div>
            
            <div class="flex flex-col md:flex-row justify-center gap-6 mb-20">
                <a href="/register-a-limited-company-uk" class="btn-primary">Start Registration</a>
                <a href="/pricing" class="px-10 py-5 bg-white text-gray-900 border border-gray-100 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-gray-50 transition shadow-sm">Compare Packages</a>
            </div>

            <!-- Hero Image -->
            <div class="max-w-6xl mx-auto mb-10 rounded-[2.5rem] overflow-hidden shadow-2xl relative">
                <div class="absolute inset-0 bg-brand-blue/10 mix-blend-overlay z-10 pointer-events-none"></div>
                <% const heroHome = "/images/hero-home"; %>
                <picture>
                    <source srcset="<%= heroHome %>-1200.avif 1200w, <%= heroHome %>-800.avif 800w, <%= heroHome %>-400.avif 400w" type="image/avif" sizes="100vw">
                    <source srcset="<%= heroHome %>-1200.webp 1200w, <%= heroHome %>-800.webp 800w, <%= heroHome %>-400.webp 400w" type="image/webp" sizes="100vw">
                    <img src="/images/hero-home.webp" alt="UK Limited Company Registration Online" width="1200" height="550" class="w-full h-[300px] md:h-[550px] object-cover" fetchpriority="high" decoding="async">
                </picture>
            </div>
        </div>
    </section>

    <!-- Trust Bar -->
    <section class="py-10 bg-gray-50 border-y border-gray-100">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto text-center">
                <div class="flex flex-col items-center justify-center p-4">
                    <span class="text-brand-blue text-2xl mb-2">✓</span>
                    <p class="text-xs font-black uppercase tracking-wider text-gray-900">Companies House Approved</p>
                </div>
                <div class="flex flex-col items-center justify-center p-4">
                    <span class="text-brand-blue text-2xl mb-2">✓</span>
                    <p class="text-xs font-black uppercase tracking-wider text-gray-900">Same-Day Service</p>
                </div>
                <div class="flex flex-col items-center justify-center p-4">
                    <span class="text-brand-blue text-2xl mb-2">✓</span>
                    <p class="text-xs font-black uppercase tracking-wider text-gray-900">10,000+ Companies Formed</p>
                </div>
                <div class="flex flex-col items-center justify-center p-4">
                    <span class="text-brand-blue text-2xl mb-2">✓</span>
                    <p class="text-xs font-black uppercase tracking-wider text-gray-900">UK-Based Expert Support</p>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-24 bg-gray-50/50 border-y border-gray-100">
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-4">How It Works</h2>
                <p class="text-lg text-gray-600">Form your UK limited company in three easy steps.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 max-w-5xl mx-auto relative">
                <!-- Step 1 -->
                <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm relative z-10 text-center">
                    <div class="w-16 h-16 bg-blue-50 text-brand-blue rounded-2xl flex items-center justify-center font-black text-2xl mx-auto mb-6 shadow-md">01</div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Enter Details</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Pick your company name and add your director info. We check name availability instantly.
                    </p>
                </div>
                <!-- Step 2 -->
                <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm relative z-10 text-center">
                    <div class="w-16 h-16 bg-blue-50 text-brand-blue rounded-2xl flex items-center justify-center font-black text-2xl mx-auto mb-6 shadow-md">02</div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Choose Package</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Select Starter, Standard Plus, or Enterprise Elite based on your needs.
                    </p>
                </div>
                <!-- Step 3 -->
                <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm relative z-10 text-center">
                    <div class="w-16 h-16 bg-blue-50 text-brand-blue rounded-2xl flex items-center justify-center font-black text-2xl mx-auto mb-6 shadow-md">03</div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">We File & Finalize</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Our agents submit to Companies House. You get your certificate the same day.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us? Section -->
    <section class="py-24 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-20">
                <h2 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-4">Why Choose Us?</h2>
                <p class="text-lg text-gray-600">Fast, compliant, and fully transparent UK limited company formation.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
                <div class="p-8 bg-white border border-gray-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3">Lowest Price Guarantee</h3>
                    <p class="text-gray-600 text-xs leading-relaxed">
                        Flat-rate pricing from £119.99. The £100 filing fee is included. No hidden charges.
                    </p>
                </div>
                
                <div class="p-8 bg-white border border-gray-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3">Same-Day Filing</h3>
                    <p class="text-gray-600 text-xs leading-relaxed">
                        Your filing goes to Companies House right away. Approval takes 3 to 6 hours on average.
                    </p>
                </div>
                
                <div class="p-8 bg-white border border-gray-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3">Free Address Option</h3>
                    <p class="text-gray-600 text-xs leading-relaxed">
                        Get a London W1 or EC1 address with our premium packages. Keep your home address private.
                    </p>
                </div>
                
                <div class="p-8 bg-white border border-gray-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18.364 5.636l-3.536 3.536m0 0A7.5 7.5 0 115.636 5.636h12.728z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3">Expert UK Support</h3>
                    <p class="text-gray-600 text-xs leading-relaxed">
                        Talk to real UK-based agents who know company law, tax, and banking compliance.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Packages Section -->
    <section class="py-24 bg-gray-50 border-t border-gray-100">
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-4xl font-extrabold text-gray-900 mb-4">Formation Packages</h2>
                <p class="text-xl text-gray-700">All prices include the £100 Companies House fee. No surprises.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
                <% packages.forEach(pkg => { %>
                    <div class="relative bg-white p-8 rounded-3xl border <%= pkg.popular ? 'border-blue-600 shadow-2xl scale-105 z-10' : 'border-gray-200 hover:shadow-xl' %> transition-all duration-300 flex flex-col">
                        <% if (pkg.popular) { %>
                            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-blue-600 text-white px-6 py-1 rounded-full font-bold text-sm tracking-wide shadow-lg">
                                MOST POPULAR
                            </div>
                        <% } %>
                        
                        <div class="mb-8">
                            <h3 class="text-2xl font-bold text-gray-900 mb-2"><%= pkg.name %></h3>
                            <p class="text-gray-600 text-sm h-10"><%= pkg.description %></p>
                        </div>

                        <div class="flex items-baseline mb-8">
                            <span class="text-5xl font-black text-gray-900">£<%= pkg.price %></span>
                            <span class="text-gray-500 ml-2 font-medium">+ VAT</span>
                        </div>

                        <ul class="space-y-4 mb-10 flex-1">
                            <% pkg.features.forEach((feature, idx) => { %>
                                <li class="flex items-start">
                                    <div class="mt-1 flex-shrink-0 w-5 h-5 bg-green-100 rounded-full flex items-center justify-center">
                                        <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                    </div>
                                    <span class="ml-3 text-gray-700 <%= (pkg.popular && idx < 3) ? 'font-semibold' : '' %>"><%= feature %></span>
                                </li>
                            <% }) %>
                        </ul>

                        <a href="/pricing" class="block text-center py-4 rounded-xl font-extrabold text-lg transition-all duration-300 <%= pkg.popular ? 'bg-blue-600 text-white hover:bg-blue-700 shadow-blue-200 shadow-lg' : 'border-2 border-blue-600 text-blue-600 hover:bg-blue-50' %>">
                            <%= pkg.cta %>
                        </a>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- What's Included Section -->
    <section class="py-24 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-4">What's Included</h2>
                <p class="text-lg text-gray-600">Everything you need to start trading. No extra document costs.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
                <div class="p-6 border border-gray-100 rounded-3xl bg-white shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-2xl flex items-center justify-center mx-auto mb-4 font-bold">✓</div>
                    <h3 class="font-bold text-gray-900 text-sm mb-2">Certificate of Incorporation</h3>
                    <p class="text-[11px] text-gray-500 leading-relaxed">Your official company certificate from Companies House.</p>
                </div>
                
                <div class="p-6 border border-gray-100 rounded-3xl bg-white shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-2xl flex items-center justify-center mx-auto mb-4 font-bold">✓</div>
                    <h3 class="font-bold text-gray-900 text-sm mb-2">Memorandum & Articles</h3>
                    <p class="text-[11px] text-gray-500 leading-relaxed">The formal rules that govern how your company operates.</p>
                </div>
                
                <div class="p-6 border border-gray-100 rounded-3xl bg-white shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-2xl flex items-center justify-center mx-auto mb-4 font-bold">✓</div>
                    <h3 class="font-bold text-gray-900 text-sm mb-2">Share Certificates & Digital Pack</h3>
                    <p class="text-[11px] text-gray-500 leading-relaxed">Ownership proof, HMRC notification, and all statutory documents in PDF.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Launch Center (SIC & Company Name Check) -->
    <section id="tools" class="py-24 bg-gray-50 overflow-hidden border-t border-gray-100">
        <div class="container mx-auto px-4 relative">
            <div class="max-w-5xl mx-auto relative z-10">
                <div class="text-center mb-16">
                    <h2 class="text-4xl font-extrabold text-gray-900 mb-4">Strategic Research Hub</h2>
                    <p class="text-xl text-gray-700">Check your company name and find SIC codes before you register.</p>
                </div>

                <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-2 md:p-4 overflow-hidden">
                    <div class="flex flex-col lg:flex-row">
                        <!-- Step 1: Company Search -->
                        <div class="flex-1 p-8 md:p-12 border-b lg:border-b-0 lg:border-r border-gray-100">
                            <div class="flex items-center mb-6">
                                <span class="w-12 h-12 bg-blue-600 text-white rounded-2xl flex items-center justify-center font-black text-xl shadow-lg shadow-blue-200 mr-4">01</span>
                                <h3 class="text-2xl font-bold text-gray-900">Brand Availability</h3>
                            </div>
                            <p class="text-gray-700 mb-8 font-medium">Search the official registry to check your company name.</p>
                            
                            <div class="relative group">
                                <input type="text" id="company-q" placeholder="Enter desired name..." 
                                    class="w-full pl-6 pr-32 py-5 bg-gray-50 border-2 border-transparent focus:border-blue-600 focus:bg-white rounded-2xl transition-all duration-300 outline-none text-lg font-medium shadow-inner">
                                <button onclick="searchCompany()" 
                                    class="absolute right-2 top-2 bottom-2 bg-blue-600 text-white px-8 rounded-xl font-bold hover:bg-blue-700 transition shadow-lg shadow-blue-100 active:scale-95">
                                    Verify
                                </button>
                            </div>
                            <div id="company-results" class="mt-6 space-y-3 max-h-60 overflow-y-auto pr-2 custom-scrollbar"></div>
                        </div>

                        <!-- Step 2: SIC Finder -->
                        <div class="flex-1 p-8 md:p-12 bg-gray-50/50">
                            <div class="flex items-center mb-6">
                                <span class="w-12 h-12 bg-indigo-600 text-white rounded-2xl flex items-center justify-center font-black text-xl shadow-lg shadow-indigo-200 mr-4">02</span>
                                <h3 class="text-2xl font-bold text-gray-900">Activity Classification</h3>
                            </div>
                            <p class="text-gray-700 mb-8 font-medium">Find the right SIC codes for your business.</p>
                            
                            <div class="relative group">
                                <input type="text" id="sic-q" placeholder="Search activities (e.g. tech, retail)..." 
                                    class="w-full pl-6 pr-32 py-5 bg-white border-2 border-transparent focus:border-indigo-600 rounded-2xl transition-all duration-300 outline-none text-lg font-medium shadow-sm">
                                <button onclick="searchSIC()" 
                                    class="absolute right-2 top-2 bottom-2 bg-indigo-600 text-white px-8 rounded-xl font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-100 active:scale-95">
                                    Search
                                </button>
                            </div>
                            <div id="sic-results" class="mt-6 space-y-3 max-h-60 overflow-y-auto pr-2 custom-scrollbar"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Reviews / Testimonials Section -->
    <section class="py-24 bg-white overflow-hidden border-t border-gray-100">
        <div class="container mx-auto px-4">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-4xl font-extrabold text-gray-900 mb-4">Reviews & Testimonials</h2>
                <p class="text-xl text-gray-700">Trusted by thousands of business owners worldwide.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <div class="bg-gray-50 p-8 rounded-3xl relative border border-gray-100">
                    <div class="flex items-center mb-6">
                        <div class="w-12 h-12 bg-blue-100 text-brand-blue rounded-full flex items-center justify-center mr-4 font-black">SL</div>
                        <div>
                            <h3 class="font-bold text-gray-900">Sarah L.</h3>
                            <p class="text-xs text-gray-500 font-medium">E-commerce Founder, London</p>
                        </div>
                    </div>
                    <p class="text-gray-700 italic text-sm leading-relaxed">
                        "Got my Certificate of Incorporation and London address the same day. My home details stayed off the public record. Very professional."
                    </p>
                    <div class="mt-6 flex text-yellow-400">
                        <% for(let i=0; i<5; i++) { %>
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <% } %>
                    </div>
                </div>

                <div class="bg-gray-50 p-8 rounded-3xl relative border border-gray-100">
                    <div class="flex items-center mb-6">
                        <div class="w-12 h-12 bg-blue-100 text-brand-blue rounded-full flex items-center justify-center mr-4 font-black">AM</div>
                        <div>
                            <h3 class="font-bold text-gray-900">Arshad M.</h3>
                            <p class="text-xs text-gray-500 font-medium">Textile Exporter, Karachi</p>
                        </div>
                    </div>
                    <p class="text-gray-700 italic text-sm leading-relaxed">
                        "They registered our LTD and helped us get a Wise account in under 48 hours. Brilliant service for overseas founders."
                    </p>
                    <div class="mt-6 flex text-yellow-400">
                        <% for(let i=0; i<5; i++) { %>
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <% } %>
                    </div>
                </div>

                <div class="bg-gray-50 p-8 rounded-3xl relative border border-gray-100">
                    <div class="flex items-center mb-6">
                        <div class="w-12 h-12 bg-blue-100 text-brand-blue rounded-full flex items-center justify-center mr-4 font-black">DK</div>
                        <div>
                            <h3 class="font-bold text-gray-900">David K.</h3>
                            <p class="text-xs text-gray-500 font-medium">IT Consultant, Manchester</p>
                        </div>
                    </div>
                    <p class="text-gray-700 italic text-sm leading-relaxed">
                        "The fastest formation agent I've used. Clear on 2026 ACSP rules and helped me set up Tide banking. 100% recommended."
                    </p>
                    <div class="mt-6 flex text-yellow-400">
                        <% for(let i=0; i<5; i++) { %>
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <% } %>
                    </div>
                </div>
            </div>
