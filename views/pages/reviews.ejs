<%- include('../partials/header') %>
<%- include('../partials/navigation', { user: (typeof user !== 'undefined' ? user : null) }) %>

<main class="bg-gray-50 py-24 min-h-screen">
    <div class="container mx-auto px-4 max-w-3xl">

        <div class="text-center mb-12">
            <span class="inline-block px-4 py-1.5 mb-6 bg-blue-50 text-brand-blue rounded-full text-xs font-black tracking-widest uppercase">Customer Feedback</span>
            <h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4 tracking-tight">Leave Us a Review</h1>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                If you have formed a company with us, we would like to hear how it went &mdash;
                including if something did not work as you expected.
            </p>
        </div>

        <% if (typeof ratingLabel !== 'undefined' && ratingLabel) { %>
        <div class="mb-10 text-center bg-white border border-gray-100 rounded-3xl p-6">
            <p class="text-sm text-gray-500 mb-1">Current published rating</p>
            <p class="text-2xl font-black text-gray-900"><%= ratingLabel %></p>
            <p class="text-xs text-gray-500 mt-2">Based on <%= publishedReviews.length %> published review<%= publishedReviews.length === 1 ? '' : 's' %>.</p>
        </div>
        <% } %>

        <div class="bg-white rounded-[2.5rem] border border-gray-100 shadow-sm p-8 md:p-12">
            <form id="review-form" class="space-y-6">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2" for="rv-name">Your name or initials</label>
                    <input id="rv-name" name="name" type="text" required maxlength="60"
                           class="w-full border border-gray-200 p-4 rounded-xl outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition"
                           placeholder="e.g. Sarah L. or S. Khan">
                    <p class="text-xs text-gray-400 mt-1">Published as shown. Use initials if you prefer.</p>
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2" for="rv-email">Email address</label>
                    <input id="rv-email" name="email" type="email" required maxlength="120"
                           class="w-full border border-gray-200 p-4 rounded-xl outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition"
                           placeholder="you@example.com">
                    <p class="text-xs text-gray-400 mt-1">Used only to contact you about your review. Never published.</p>
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2" for="rv-order">Order or company number <span class="font-medium normal-case text-gray-400">(optional)</span></label>
                    <input id="rv-order" name="orderNumber" type="text" maxlength="60"
                           class="w-full border border-gray-200 p-4 rounded-xl outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition"
                           placeholder="Helps us verify this is a genuine customer">
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2" for="rv-service">Service</label>
                    <select id="rv-service" name="service"
                            class="w-full border border-gray-200 p-4 rounded-xl outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition bg-white">
                        <option value="Company Formation">Company Formation</option>
                        <option value="Registered Office">Registered Office</option>
                        <option value="VAT Registration">VAT Registration</option>
                        <option value="Company Secretary">Company Secretary</option>
                        <option value="Banking Assistance">Banking Assistance</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <span class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2">Your rating</span>
                    <div id="rv-stars" class="flex gap-2 text-3xl text-gray-300">
                        <button type="button" data-star="1" aria-label="1 star">&#9733;</button>
                        <button type="button" data-star="2" aria-label="2 stars">&#9733;</button>
                        <button type="button" data-star="3" aria-label="3 stars">&#9733;</button>
                        <button type="button" data-star="4" aria-label="4 stars">&#9733;</button>
                        <button type="button" data-star="5" aria-label="5 stars">&#9733;</button>
                    </div>
                    <input type="hidden" name="rating" id="rv-rating" value="">
                    <p class="text-xs text-gray-400 mt-1">Tap a star.</p>
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2" for="rv-body">Your review</label>
                    <textarea id="rv-body" name="body" rows="6" required minlength="20" maxlength="2000"
                              class="w-full border border-gray-200 p-4 rounded-xl outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition"
                              placeholder="What happened, and how did it compare with what you expected?"></textarea>
                    <p class="text-xs text-gray-400 mt-1">At least 20 characters.</p>
                </div>

                <button type="submit" class="btn-primary w-full">Submit Review</button>

                <p class="text-xs text-gray-500 leading-relaxed">
                    By submitting you agree that we may publish what you wrote, together with the
                    name or initials you provided. We will never publish your email address.
                    Reviews are checked by a person before they appear on the site, and we do not
                    remove critical reviews &mdash; only reviews that are not from customers or
                    that we cannot verify.
                </p>

                <p class="text-xs text-gray-400">
                    Read our full <a href="/legal/review-policy" class="text-brand-blue hover:underline">Review Policy</a>.
                </p>
            </form>

            <div id="review-success" class="hidden text-center py-10">
                <div class="w-16 h-16 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mx-auto mb-6 text-3xl">&#10003;</div>
                <h2 class="text-2xl font-black text-gray-900 mb-3">Thank you</h2>
                <p class="text-gray-600" id="review-success-msg">
                    Your review has been received. We read every one before publishing, so it may take
                    a day or two before it appears on the site.
                </p>
            </div>

            <div id="review-error" class="hidden mt-6 bg-red-50 border border-red-200 text-red-800 rounded-xl p-4 text-sm"></div>
        </div>

        <div class="mt-10 bg-white rounded-3xl border border-gray-100 p-8">
            <h2 class="text-lg font-black text-gray-900 mb-3">How we handle reviews</h2>
            <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex gap-2"><span class="text-brand-blue font-bold">&bull;</span><span>Every submission is read by a person before it is published.</span></li>
                <li class="flex gap-2"><span class="text-brand-blue font-bold">&bull;</span><span>We mark a review &ldquo;Verified customer&rdquo; only when we can match it to a completed order.</span></li>
                <li class="flex gap-2"><span class="text-brand-blue font-bold">&bull;</span><span>We never publish a rating we cannot support with real reviews. If there are none, we show none.</span></li>
                <li class="flex gap-2"><span class="text-brand-blue font-bold">&bull;</span><span>We do not delete negative reviews. We remove only spam and anything we cannot attribute to a customer.</span></li>
                <li class="flex gap-2"><span class="text-brand-blue font-bold">&bull;</span><span>Your email address is never published and is only used to follow up with you.</span></li>
            </ul>
        </div>

    </div>
</main>

<script>
(function () {
    var form = document.getElementById('review-form');
    var starsWrap = document.getElementById('rv-stars');
    var hidden = document.getElementById('rv-rating');
    var errBox = document.getElementById('review-error');
    var chosen = 0;

    starsWrap.querySelectorAll('button[data-star]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            chosen = parseInt(btn.getAttribute('data-star'), 10);
            hidden.value = chosen;
            starsWrap.querySelectorAll('button').forEach(function (b, i) {
                b.style.color = i < chosen ? '#f59e0b' : '#d1d5db';
            });
        });
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        errBox.classList.add('hidden');

        if (!chosen) {
            errBox.textContent = 'Please choose a star rating.';
            errBox.classList.remove('hidden');
            return;
        }

        var data = {
            name: form.name.value.trim(),
            email: form.email.value.trim(),
            rating: chosen,
            body: form.body.value.trim(),
            service: form.service.value,
            orderNumber: form.orderNumber.value.trim()
        };

        if (data.body.length < 20) {
            errBox.textContent = 'Please write at least 20 characters.';
            errBox.classList.remove('hidden');
            return;
        }

        var btn = form.querySelector('button[type=submit]');
        btn.disabled = true;
        btn.textContent = 'Sending...';

        fetch('/api/review', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
          .then(function (res) {
              if (!res.ok) throw new Error(res.body.message || 'Submission failed.');
              form.classList.add('hidden');
              document.getElementById('review-success').classList.remove('hidden');
          })
          .catch(function (err) {
              errBox.textContent = err.message;
              errBox.classList.remove('hidden');
              btn.disabled = false;
              btn.textContent = 'Submit Review';
          });
    });
})();
</script>

<%- include('../partials/footer') %>
