# Safe environment template for local development and AI Studio deployment.
# Do not commit real secrets. Fill these values in your deployment environment.

# Server Configuration
NODE_ENV=development
PORT=3000
SITE_URL=https://your-domain.example

# Database (MongoDB - Optional)
MONGODB_URI=

# Session Secret (set a strong random value in your actual environment)
SESSION_SECRET=

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email Addresses
EMAIL_INFO=info@your-domain.example
EMAIL_SUPPORT=support@your-domain.example
EMAIL_HELLO=hello@your-domain.example

# AI Chatbot
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Companies House API
COMPANIES_HOUSE_API_KEY=

# Admin Configuration
ADMIN_EMAIL=admin@your-domain.example
SITE_NAME=UK Ltd Registration

# External Services (Optional)
GOOGLE_ANALYTICS_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Lead Capture — Google Sheets (optional)
# When set, every enquiry is appended to this spreadsheet in addition to the
# durable local store at data/leads.jsonl. Column order: Timestamp, Property,
# Visitor Name, Email, Intent, Source URL, Status.
# LEAD_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# Path to the Google service account JSON used for Sheets writes.
# LEAD_SERVICE_ACCOUNT=/path/to/service-account.json
#
# Lead Capture — Google Apps Script webhook (alternative to LEAD_SHEET_ID).
# Needs no GCP API enablement: create a Sheet, add an Apps Script that appends
# the POSTed fields, deploy as a web app, and paste the /exec URL here.
# LEAD_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

